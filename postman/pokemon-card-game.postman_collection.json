{
  "info": {
    "name": "Pokemon Card Game API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "roomCode", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('body says ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List cards (limit 5)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cards?limit=5&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cards"],
          "query": [
            { "key": "limit", "value": "5" },
            { "key": "offset", "value": "0" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns 5 cards and a total', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.cards).to.have.lengthOf(5);",
              "  pm.expect(body.total).to.be.above(1000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get card 3 (Venusaur)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cards/3",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cards", "3"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('is Venusaur', function () { pm.expect(pm.response.json().displayName).to.eql('Venusaur'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Mega card 10033 (rank stays 3)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cards/10033",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cards", "10033"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Mega Venusaur keeps species rank 3', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.displayName).to.eql('Mega Venusaur');",
              "  pm.expect(body.stats.rank).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Bad limit (expect 400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cards?limit=0",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cards"],
          "query": [{ "key": "limit", "value": "0" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('validation error', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Card not found (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cards/99999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cards", "99999999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('card not found', function () { pm.expect(pm.response.json().error.code).to.eql('CARD_NOT_FOUND'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create room",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/rooms", "host": ["{{baseUrl}}"], "path": ["api", "rooms"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('code has 6 allowed characters', function () {",
              "  pm.expect(pm.response.json().code).to.match(/^[A-HJ-NP-Z2-9]{6}$/);",
              "});",
              "pm.collectionVariables.set('roomCode', pm.response.json().code);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get room (uses the code just created)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms/{{roomCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms", "{{roomCode}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('room is an empty lobby', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(pm.collectionVariables.get('roomCode'));",
              "  pm.expect(body.status).to.eql('lobby');",
              "  pm.expect(body.playerCount).to.eql(0);",
              "  pm.expect(body.maxPlayers).to.eql(6);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Room not found (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms/ZZZZZZ",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms", "ZZZZZZ"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('room not found', function () { pm.expect(pm.response.json().error.code).to.eql('ROOM_NOT_FOUND'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid room code (expect 400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms/abc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms", "abc"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('validation error', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown route (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/nope", "host": ["{{baseUrl}}"], "path": ["api", "nope"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('JSON error, no stack trace', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.error.code).to.eql('NOT_FOUND');",
              "  pm.expect(JSON.stringify(body)).to.not.include('stack');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
