{
  "name": "pokemon-multiplayer-card-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared",
    "scripts"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:client": "npm run dev --workspace @pokemon-game/client",
    "build:client": "npm run build --workspace @pokemon-game/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.9"
  }
}
