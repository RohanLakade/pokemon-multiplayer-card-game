{
  "name": "pokemon-multiplayer-card-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared",
    "scripts"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:client": "npm run dev --workspace @pokemon-game/client",
    "dev:server": "npm run dev --workspace @pokemon-game/server",
    "build:client": "npm run build --workspace @pokemon-game/client",
    "build:cards": "npm run build:cards --workspace @pokemon-game/scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "vitest": "^5.0.3"
  }
}
